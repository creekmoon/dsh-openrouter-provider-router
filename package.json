{
  "name": "@creekmoon/dsh-openrouter-provider",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pin each OpenRouter model to the providers you choose, from a dedicated Settings page.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "openrouter",
    "provider-routing"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/run.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "design/wireframe.html"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
