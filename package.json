{
  "name": "@creekmoon/dsh-openrouter-provider-router",
  "version": "1.0.2",
  "type": "module",
  "description": "Pin each OpenRouter model to the providers you choose, from a dedicated Settings page.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "openrouter",
    "openrouter-provider",
    "provider-routing",
    "llm-routing",
    "settings-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creekmoon/dsh-openrouter-provider-router.git"
  },
  "homepage": "https://github.com/creekmoon/dsh-openrouter-provider-router#readme",
  "bugs": {
    "url": "https://github.com/creekmoon/dsh-openrouter-provider-router/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/run.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
